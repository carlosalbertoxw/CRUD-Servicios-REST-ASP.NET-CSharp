<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 sobre Microsoft.Testing.Platform: cada proyecto de pruebas
         es un ejecutable (ver global.json). -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.MySql" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NotesApi\NotesApi.csproj" />
    <ProjectReference Include="..\..\src\NotesApi.Migrations\NotesApi.Migrations.csproj" />
  </ItemGroup>

</Project>
