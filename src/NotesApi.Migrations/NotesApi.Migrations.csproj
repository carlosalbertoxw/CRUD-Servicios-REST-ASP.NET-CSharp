<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dbup-mysql" />
    <!-- Referencia directa para no heredar la versión vulnerable que trae dbup-mysql
         como transitiva (GHSA-473q-m89c-ghf8). -->
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scripts\**\*.sql" />
    <EmbeddedResource Include="Seeds\**\*.sql" />
  </ItemGroup>

</Project>
